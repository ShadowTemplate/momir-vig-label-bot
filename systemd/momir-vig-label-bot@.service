# Install (host-independent): sudo cp systemd/momir-vig-label-bot@.service /etc/systemd/system/
#                              sudo systemctl daemon-reload
#                              sudo systemctl enable --now momir-vig-label-bot@<your-username>.service
# Assumes <your-username>'s home dir contains this repo checked out as ~/momir-vig-label-bot with a venv at ./venv.
# Uses $HOME (set by systemd from User=) rather than the %h specifier, which does not reliably
# resolve against User=%i on older systemd (confirmed broken on systemd 247 / Debian Bullseye).
[Unit]
Description=Momir Vig Label Telegram Bot (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
ExecStartPre=/bin/sh -c 'until getent hosts google.com >/dev/null 2>&1; do sleep 1; done'
ExecStart=/bin/sh -c 'cd "$HOME/momir-vig-label-bot" && PYTHONPATH="$PWD" exec venv/bin/python3 momir_vig_label_bot/main.py'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
